{
  "compilerOptions": {
    // The compiler contract of @cravingmaker/eslint-config, which lints this repository. Its
    // TypeScript rules leave unreachable code and missing returns to the compiler.
    "allowUnreachableCode": false,
    "noImplicitReturns": true,
    "strict": true,

    // Checks beyond that contract.
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,

    // Node.js 24.15, the minimum runtime: ES2025 and the newer APIs that it ships.
    "lib": ["ES2025", "ESNext.Array", "ESNext.Disposable", "ESNext.Error"],
    "module": "NodeNext",
    "target": "ES2025",
    "types": ["node"],

    // tsdown builds `dist/`; the compiler only checks. Relative imports name the `.ts` file, so
    // Node.js runs every script and test helper directly.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "exclude": ["tests/fixtures"],
  "include": [
    "scripts/**/*",
    "src/**/*",
    "tests/**/*",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
